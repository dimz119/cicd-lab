# staging: production과 구조가 같은 리허설 환경.
# 외부 결제는 sandbox를 쓰고, 그 밖의 값은 production에 맞춘다.

# --- 앱 설정 (컨테이너에 그대로 들어간다) ---
APP_ENV=staging
LOG_LEVEL=INFO
PAYMENT_API_URL=https://sandbox.pay.example.com
FLAG_CACHE_TTL_SECONDS=5

# --- 인프라 설정 (배포 스크립트가 쓴다) ---
ROUTER_PORT=8082
PREVIEW_PORT=9082
DB_PORT=5442
